# =========================
# 数据与特征矩阵 (严格隔离)
# =========================
# 匹配 Data 目录下所有层级的各类数据文件
Data/**/*.mat
Data/**/*.npy
Data/**/*.h5
Data/**/*.csv
# 全局兜底：防止数据文件出现在非 Data 目录
*.mat
*.npy
*.h5
*.csv

# =========================
# Python 编译与运行缓存
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
# Python 3.8+ 字节码缓存目录
.python-version
# pytest 缓存
.pytest_cache/
# 单元测试缓存
.coverage
htmlcov/

# =========================
# 虚拟环境隔离
# =========================
venv/
env/
.env
.venv/
miniconda3/
Anaconda3/
# Conda 环境配置
conda-meta/
envs/

# =========================
# IDE 与操作系统缓存
# =========================
.vscode/
.idea/
# Jupyter 缓存
.ipynb_checkpoints/
*.ipynb.out
# 系统文件
.DS_Store
Thumbs.db
# 编辑器临时文件
*~
*.swp

# =========================
# 补充：日志/临时文件
# =========================
*.log
*.tmp
*.temp